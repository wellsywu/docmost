{
  "name": "publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migration:up": "tsx src/database/migrate.ts latest",
    "migration:down": "tsx src/database/migrate.ts down"
  },
  "dependencies": {
    "@docmost/integration-db": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "fastify": "5.8.5",
    "highlight.js": "11.11.1",
    "isomorphic-dompurify": "2.29.0",
    "jsdom": "29.1.1",
    "juice": "11.0.3",
    "kysely": "0.28.17",
    "kysely-postgres-js": "3.0.0",
    "marked": "16.4.0",
    "mermaid": "11.15.0",
    "postgres": "3.4.8",
    "undici": "7.28.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@types/jsdom": "27.0.0",
    "@types/node": "25.5.0",
    "eslint": "9.28.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.4.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1"
  }
}
