PUBLISHER_HOST=127.0.0.1
PUBLISHER_PORT=3050
PUBLISHER_DATABASE_URL=postgres://publisher:publisher@127.0.0.1:5432/publisher
PUBLISHER_USE_MEMORY_STORE=1
# API authentication. Live mode requires this to stay on.
PUBLISHER_AUTH_ENABLED=1
PUBLISHER_ACCESS_TOKEN=publisher_placeholder_2a4c90f8e1d7428b
# Optional PNG/JPEG used as the WeChat cover when an article has no image.
# PUBLISHER_DEFAULT_COVER_PATH=./assets/default-cover.png

DOCMOST_BASE_URL=https://docmost.example.internal/api
DOCMOST_API_KEY=dm_placeholder_6fb914aa8d4d48df
DOCMOST_VERIFY_TLS=1
DOCMOST_MAX_ASSET_BYTES=10485760

WECHAT_MODE=mock
# Live mode decrypts the selected wechat_accounts row. This must equal
# Docmost APP_SECRET. APP_SECRET is also accepted as a compatibility alias.
# INTEGRATION_ENCRYPTION_SECRET=replace_with_docmost_app_secret
WECHAT_API_BASE_URL=https://api.weixin.qq.com
WECHAT_MAX_IMAGE_BYTES=10485760

# Defaults to a template id derived from the renderer stylesheet; only set this
# to pin a specific version.
# PUBLISHER_TEMPLATE_VERSION=
